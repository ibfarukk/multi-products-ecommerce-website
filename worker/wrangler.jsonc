{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multi-products-ecommerce-website",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OWNER_STATS"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "${R2_BUCKET_NAME}"
    }
  ]
}
