{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multi-products-ecommerce-website",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "assets": {
    "directory": "..",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/cdn/*",
      "/",
      "/index.html",
      "/multiple",
      "/multiple.html",
      "/affiliate",
      "/affiliate.html",
      "/cart-checkout",
      "/cart-checkout.html",
      "/checkout",
      "/checkout.html",
      "/success",
      "/success.html",
      "/payment-failed",
      "/payment-failed.html",
      "/product-details",
      "/product-details.html",
      "/owner",
      "/owner.html",
      "/js/config.js",
      "/js/config2.js",
      "/js/config3.js",
      "/js/site_selector.js"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OWNER_STATS"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "multi-products-ecommerce-images",
      "preview_bucket_name": "multi-products-ecommerce-images"
    }
  ]
}
