
PAYSTACK_SECRET_KEY=paystack_secret_key_here

# =========================================================
# FLUTTERWAVE PAYMENT CONFIGURATION
# Get keys from https://dashboard.flutterwave.com/dashboard/settings/apis
# =========================================================
# Secret Key (server-side verification & webhook validation)
FLUTTERWAVE_SECRET_KEY=flutterwave_secret
# Flutterwave Business / Merchant ID (optional, for reference)
FLUTTERWAVE_BUSINESS_ID=flutterwave_bussinessid
# Webhook Hash (optional) - shown in Flutterwave dashboard under Webhooks
FLUTTERWAVE_WEBHOOK_HASH=
# Public Key - exposed to customers via site config; override in Owner Dashboard if needed
FLUTTERWAVE_PUBLIC_KEY=

OWNER_EMAIL=owner@example.com
OWNER_DASHBOARD_USERNAME=owner
OWNER_DASHBOARD_PASSWORD=change_this_dashboard_password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=yourgmail@gmail.com
GMAIL_SMTP_PASSWORD=your_16_character_gmail_app_password
GMAIL_FROM_EMAIL=yourgmail@gmail.com
MAIL_FROM=yourgmail@gmail.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=orders@yourdomain.com
DISCORD_WEBHOOK_URL=discord_webhook_url
TELEGRAM_BOT_TOKEN=123456789:your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890

# =========================================================
# CLOUDFLARE R2 STORAGE CONFIGURATION
# Used for product images, logos, and other uploads
# =========================================================
# R2 Bucket Name - create this in Cloudflare Dashboard > R2
R2_BUCKET_NAME=your-r2-bucket-name
# Cloudflare Account ID - found in Cloudflare Dashboard URL
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 Access Key ID - create in Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2 Secret Access Key - paired with the Access Key ID above
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2 Public Bucket URL (optional) - for direct public access to objects
# Format: https://[bucket-name].[account-id].r2.cloudflarestorage.com
# Or use a custom domain connected to your R2 bucket
R2_PUBLIC_URL=
# Custom domain for R2 CDN delivery (optional, e.g., cdn.yourdomain.com)
R2_CUSTOM_DOMAIN=
